# secreto para validar que el post viene de wialon (va como query param ?token=)
WIALON_WEBHOOK_SECRET=cambiame

# token del bot, te lo da @BotFather en telegram
TELEGRAM_BOT_TOKEN=

# supabase, opcional en desarrollo (si no estan seteadas, se usa un store en memoria)
# obligatorio en produccion (vercel), porque en serverless la memoria no persiste
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# usuario y contraseña para acceder a la pagina web y al listado de notificaciones
# si se dejan vacias, no se pide login (comodo en dev local, pero setealas siempre en vercel)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
